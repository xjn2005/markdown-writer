{
  "name": "@rinspacehq/markdown-writer",
  "version": "0.3.5",
  "description": "Rinspace Markdown Editor built with Milkdown and Crepe",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "bin",
    "template",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./interactions": {
      "types": "./dist/interactions.d.ts",
      "import": "./dist/interactions.js"
    },
    "./writer": {
      "types": "./dist/writer.d.ts",
      "import": "./dist/writer.js"
    },
    "./page": {
      "types": "./dist/page.d.ts",
      "import": "./dist/page.js"
    },
    "./writer.css": "./dist/writer.css",
    "./latex-editor": {
      "types": "./dist/LatexBlockEditor.d.ts",
      "import": "./dist/latex-editor.js"
    },
    "./code-editor": {
      "types": "./dist/CodeMirrorEditor.d.ts",
      "import": "./dist/code-editor.js"
    }
  },
  "bin": {
    "markdown-writer": "bin/create-demo.mjs"
  },
  "scripts": {
    "build": "vite build --config vite.config.ts && tsc -p tsconfig.json",
    "test": "vitest run --pool forks --maxWorkers 1",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@milkdown/crepe": "7.22.2",
    "@milkdown/kit": "7.22.2",
    "@codemirror/commands": "6.10.3",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/language": "6.12.3",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.43.1",
    "@lezer/highlight": "1.2.3",
    "katex": "^0.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@milkdown/crepe": "7.22.2",
    "@milkdown/kit": "7.22.2",
    "@codemirror/commands": "6.10.3",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/language": "6.12.3",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.43.1",
    "@lezer/highlight": "1.2.3",
    "katex": "0.19.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "katex": "0.19.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rinspacehq/rinspace-editor-markdown.git"
  },
  "homepage": "https://github.com/rinspacehq/rinspace-editor-markdown#readme",
  "bugs": {
    "url": "https://github.com/rinspacehq/rinspace-editor-markdown/issues"
  },
  "keywords": [
    "milkdown",
    "markdown",
    "editor",
    "math",
    "table"
  ]
}
